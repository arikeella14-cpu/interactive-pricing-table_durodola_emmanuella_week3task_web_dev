            transition: background 0.2s, color 0.2s;
        }

        .select-btn:hover {
            border-color: #6366f1;
        }

        .pricing-card.selected .select-btn {
            background: #6366f1;
            color: #ffffff;
            border-color: #6366f1;
        }

        .select-btn:focus-visible {
            outline: 3px solid #a5b4fc;
            outline-offset: 3px;
        }

        /* Selection status */
        .selection-status {
            margin-top: 30px;
            padding: 18px 22px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
