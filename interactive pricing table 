    <script>
        const cards = document.querySelectorAll(".pricing-card");

        const selectedPlan = document.getElementById("selected-plan");
        const selectedDescription =
            document.getElementById("selected-description");

        const resetButton =
            document.getElementById("reset-selection");

        const planDetails = {
            Starter: {
                price: "$0 forever",
                description: "A simple place to start."
            },

            Pro: {
                price: "$19/month",
                description: "Great for growing teams."
            },

            Business: {
                price: "$49/month",
                description: "Built for teams ready to scale."
            }
        };

        function selectPlan(card) {
            const planName = card.dataset.plan;
            const details = planDetails[planName];

            // Update card selection
            cards.forEach(function (item) {
                const isSelected = item === card;

                item.classList.toggle("selected", isSelected);

                item.setAttribute(
                    "aria-checked",
                    String(isSelected)
                );

                const button = item.querySelector(".select-btn");

                button.textContent = isSelected
                    ? "Selected ✓"
                    : "Choose " + item.dataset.plan;
            });

            // Update the selection information
            selectedPlan.textContent =
                planName + " plan · " + details.price;

            selectedDescription.textContent =
                details.description;
        }

        // Allow selection by clicking the card or its button
        cards.forEach(function (card) {
            card.addEventListener("click", function () {
                selectPlan(card);
            });

            // Keyboard accessibility
            card.addEventListener("keydown", function (event) {
                if (
                    event.target === card &&
                    (event.key === "Enter" || event.key === " ")
                ) {
                    event.preventDefault();
                    selectPlan(card);
                }
            });
        });

        // Reset to the default Pro plan
        resetButton.addEventListener("click", function () {
            const defaultPlan = document.querySelector(
                '.pricing-card[data-plan="Pro"]'
            );

            selectPlan(defaultPlan);
        });
    </script>

