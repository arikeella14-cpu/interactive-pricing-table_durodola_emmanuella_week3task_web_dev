        }

        .features-heading {
            color: #64748b;
            font-size: 12px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 18px;
        }

        /* Flexible feature list */
        .features {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 15px;
            flex: 1;
            margin-bottom: 28px;
        }

        .features li {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-size: 14px;
            line-height: 1.6;
        }

        .check {
            color: #6366f1;
            font-weight: bold;
            flex-shrink: 0;
        }

        /* Action buttons stay aligned */
        .select-btn {
            width: 100%;
            min-height: 48px;
            margin-top: auto;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            background: #ffffff;
