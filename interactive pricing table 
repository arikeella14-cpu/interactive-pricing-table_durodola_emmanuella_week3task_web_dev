        }

        .card-header p {
            color: #64748b;
            font-size: 14px;
            line-height: 1.6;
        }

        /* Aligned prices */
        .price {
            min-height: 85px;
            display: flex;
            align-items: baseline;
            gap: 5px;
            flex-wrap: wrap;
            border-bottom: 1px solid #e2e8f0;
